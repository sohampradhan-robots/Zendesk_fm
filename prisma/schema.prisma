generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FmDetails {
  id           Int       @id @default(autoincrement())
  customer     String?
  site         String?
  time_zone    String?
  name_of_tug  String    @unique
  vehicle_type String?
  hosted_env   String?
  local_ip     String?
  wireguard_ip String?
  mule_version String?
  fm_version   String?
  dashboard    String?
  primary_temp Int?      @unique(map: "fm_details_PrimaryTemp_key") @db.SmallInt
  updated_at   DateTime? @db.Timestamptz(6)

  @@map("fm_details")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(100)
  password String

  @@map("users")
}